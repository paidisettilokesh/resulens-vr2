# ── ResuLens Frontend Environment Configurations ──────────────────────────────

# The Backend API server location (MUST NOT have trailing slash)
# Local development:
VITE_BACKEND_URL=http://localhost:5000

# Production (e.g. Render Web Service URL deployed for backend):
# VITE_BACKEND_URL=https://resulens-backend.onrender.com

# Google Client ID from Google Developer Console for Sign in with Google (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
